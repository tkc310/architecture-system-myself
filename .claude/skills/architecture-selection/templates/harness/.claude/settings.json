{
  "permissions": {
    "deny": [
      "Bash(pnpm *)",
      "Bash(pnpx *)",
      "Bash(npx *)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(bunx *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard-paths.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/check-edited-file.sh"
          }
        ]
      }
    ]
  }
}
