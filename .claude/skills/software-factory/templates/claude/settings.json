{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(make help)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make test-watch)",
      "Bash(make test-coverage)",
      "Bash(make lint)",
      "Bash(make lint-deps)",
      "Bash(make typecheck)",
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make check-versions)",
      "Bash(make check-supply-chain)",
      "Bash(make doctor)",
      "Bash(make why *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(make build)",
      "Bash(make generate-check)",
      "Bash(make outdated)",
      "Bash(git log)"
    ],
    "ask": [
      "Bash(make add *)",
      "Bash(make add-dev *)",
      "Bash(make add-dev-exact *)",
      "Bash(make remove *)",
      "Bash(make install)",
      "Bash(make setup)",
      "Bash(make generate)",
      "Bash(make ui-add *)",
      "Bash(make ui-update *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh api *)",
      "WebFetch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(~/.npmrc)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(pnpm *)",
      "Bash(pnpx *)",
      "Bash(npx *)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(bunx *)",
      "Bash(make -*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard-paths.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/check-edited-file.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-check-on-stop.sh"
          }
        ]
      }
    ]
  }
}
